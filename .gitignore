build/
# Per-machine settings; see docs/build-and-run.md.
local.mk
# Its own repository: github.com/tunixos/tunix-ports
tunix-ports/
*.o
# No *.d here on purpose. Dependency files are only ever written under build/,
# which is ignored whole -- and the pattern also matches any *directory* whose
# name ends in .d, which quietly kept etc/sudoers.d out of the repository.
*.elf
*.bin
*.img
*.img.gz
*.log
*.orig
*.rej
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc
