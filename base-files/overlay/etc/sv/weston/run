#!/bin/sh
exec 2>&1

sv start seatd >/dev/null || exit 1
attempt=0
while [ ! -S /run/seatd.sock ]; do
	attempt=$((attempt + 1))
	[ "$attempt" -gt 60 ] && exit 1
	sleep 0.5
done

export HOME=/home/tunix
export USER=tunix
export LOGNAME=tunix
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_CONFIG_DIRS=/etc/xdg
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Weston
export SHELL=/bin/bash
if grep -qs '^DRIVER=virtio_gpu$' /sys/devices/card0/uevent; then
	unset LIBGL_ALWAYS_SOFTWARE
	unset GALLIUM_DRIVER
else
	export LIBGL_ALWAYS_SOFTWARE=1
	export GALLIUM_DRIVER=llvmpipe
fi
export EGL_PLATFORM=wayland

export MOZ_ENABLE_WAYLAND=1
export MOZ_DISABLE_CONTENT_SANDBOX=1
export MOZ_DISABLE_GMP_SANDBOX=1
export MOZ_DISABLE_RDD_SANDBOX=1
export MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1
export MOZ_DISABLE_UTILITY_SANDBOX=1
export MOZ_ACCELERATED=0

install -d -m 0700 -o tunix -g tunix "$XDG_RUNTIME_DIR"

cd "$HOME" || exit 1
exec chpst -u tunix:tunix:_seatd:audio weston
