#!/usr/bin/python3
"""Prove the ported Python actually works on Tunix.

Not a language test -- CPython's own suite would cover that, and it is stripped
from the image. This exercises the places where Python leans on the kernel, so
a pass says the syscall surface holds rather than that the interpreter parses.

Every check prints PASS or FAIL and the script exits non-zero if any failed.
"""

import os
import sys
import traceback

failures = []


def check(name, fn):
    try:
        detail = fn()
    except Exception:
        failures.append(name)
        print("FAIL  %-22s %s" % (name, traceback.format_exc().splitlines()[-1]))
    else:
        print("PASS  %-22s %s" % (name, detail if detail else ""))


def imports():
    import json, sqlite3, ctypes, socket, select, threading, subprocess
    import hashlib, zlib, xml.etree.ElementTree
    return "json sqlite3 ctypes socket select threading subprocess hashlib zlib expat"


def files():
    path = "/tmp/python-test.txt"
    payload = "".join(chr(0x20 + (i % 90)) for i in range(10000))
    with open(path, "w") as handle:
        handle.write(payload)
    with open(path) as handle:
        back = handle.read()
    os.unlink(path)
    assert back == payload, "content did not survive the round trip"
    return "%d bytes written, read back and unlinked" % len(payload)


def directories():
    entries = os.listdir("/usr/lib")
    assert "libpython3.14.so.1.0" in entries, "libpython missing from /usr/lib"
    stat = os.stat("/usr/bin/python3")
    return "%d entries in /usr/lib, python3 is %d bytes" % (len(entries), stat.st_size)


def threads():
    import threading

    total = []
    lock = threading.Lock()

    def worker(n):
        value = sum(range(n * 1000, (n + 1) * 1000))
        with lock:
            total.append(value)

    workers = [threading.Thread(target=worker, args=(i,)) for i in range(8)]
    for worker_thread in workers:
        worker_thread.start()
    for worker_thread in workers:
        worker_thread.join()
    assert len(total) == 8, "only %d of 8 threads finished" % len(total)
    return "8 threads joined, sum %d" % sum(total)


def subprocesses():
    import subprocess

    result = subprocess.run(["/bin/echo", "hello from a child"],
                            capture_output=True, text=True, timeout=30)
    assert result.returncode == 0, "echo exited %d" % result.returncode
    assert "hello from a child" in result.stdout, "stdout was %r" % result.stdout
    return "fork+exec+pipe: %r" % result.stdout.strip()


def signals():
    import signal, threading

    fired = threading.Event()
    signal.signal(signal.SIGUSR1, lambda number, frame: fired.set())
    os.kill(os.getpid(), signal.SIGUSR1)
    assert fired.wait(5), "SIGUSR1 handler never ran"
    return "SIGUSR1 delivered to a Python handler"


def sockets():
    """Unix domain sockets, which is what a desktop actually talks over.

    X11, Wayland and D-Bus all run over the path below. The TCP equivalent is
    a separate check now that the inet layer has a server side too.
    """
    import socket, threading

    path = "/tmp/python-test.sock"
    if os.path.exists(path):
        os.unlink(path)

    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(path)
    listener.listen(1)

    received = []

    def serve():
        connection, _ = listener.accept()
        received.append(connection.recv(64))
        connection.sendall(b"pong")
        connection.close()

    server = threading.Thread(target=serve)
    server.start()

    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.connect(path)
    client.sendall(b"ping")
    answer = client.recv(64)
    client.close()
    server.join(10)
    listener.close()
    # bind() keeps the name in the kernel's own table and does not create a
    # socket file, so there may be nothing on the filesystem to remove. That is
    # a deviation from POSIX rather than part of what this checks.
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass

    assert received == [b"ping"], "server got %r" % received
    assert answer == b"pong", "client got %r" % answer
    return "unix stream socket, ping/pong across two threads"


def inet_sockets():
    """A TCP server and client, both on this machine.

    This needs two things that used to be missing together: 127.0.0.1 has to
    come back up the stack instead of going to the adapter, and a socket has to
    be able to wait for a connection. Neither is observable without the other.
    """
    import socket, threading

    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    listener.bind(("127.0.0.1", 8137))
    listener.listen(2)
    port = listener.getsockname()[1]

    seen = []

    def serve():
        connection, peer = listener.accept()
        seen.append(peer)
        seen.append(connection.recv(64))
        connection.sendall(b"pong")
        connection.close()

    server = threading.Thread(target=serve)
    server.start()

    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.connect(("127.0.0.1", port))
    client.sendall(b"ping")
    answer = client.recv(64)
    client.close()
    server.join(10)
    listener.close()

    assert seen and seen[0][0] == "127.0.0.1", "peer was %r" % (seen[:1],)
    assert seen[1:] == [b"ping"], "server got %r" % (seen[1:],)
    assert answer == b"pong", "client got %r" % answer

    datagram = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    datagram.bind(("127.0.0.1", 8138))
    datagram.sendto(b"loop", ("127.0.0.1", 8138))
    datagram.settimeout(10)
    back, source = datagram.recvfrom(64)
    datagram.close()
    assert back == b"loop", "datagram came back as %r" % back
    assert source[0] == "127.0.0.1", "datagram came from %r" % (source,)

    return "tcp accept/connect and a udp round trip, both over 127.0.0.1"


def polling():
    import select

    read_fd, write_fd = os.pipe()
    poller = select.epoll()
    poller.register(read_fd, select.EPOLLIN)
    os.write(write_fd, b"x")
    events = poller.poll(5)
    poller.close()
    os.close(read_fd)
    os.close(write_fd)
    assert events, "epoll reported nothing on a readable pipe"
    return "epoll woke on a readable pipe"


def database_memory():
    import sqlite3

    connection = sqlite3.connect(":memory:")
    connection.execute("CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
    connection.execute("INSERT INTO t (name) VALUES ('one')")
    rows = connection.execute("SELECT name FROM t").fetchall()
    connection.close()
    assert rows == [("one",)], rows
    return "sqlite3 %s in memory" % sqlite3.sqlite_version


def database():
    import sqlite3

    connection = sqlite3.connect("/tmp/python-test.db")
    connection.execute("CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
    connection.executemany("INSERT INTO t (name) VALUES (?)",
                           [("one",), ("two",), ("three",)])
    connection.commit()
    rows = connection.execute("SELECT name FROM t ORDER BY id").fetchall()
    connection.close()
    os.unlink("/tmp/python-test.db")
    assert [row[0] for row in rows] == ["one", "two", "three"], rows
    return "sqlite3 %s, 3 rows round-tripped to disk" % sqlite3.sqlite_version


def foreign_calls():
    import ctypes
    import ctypes.util

    libc = ctypes.CDLL(None)
    libc.getpid.restype = ctypes.c_int
    assert libc.getpid() == os.getpid(), "ctypes getpid disagreed with os.getpid"

    buffer = ctypes.create_string_buffer(32)
    libc.strcpy(buffer, b"through libffi")
    assert buffer.value == b"through libffi", buffer.value
    return "dlopen + libffi call into libc"


def memory_mapping():
    import mmap

    path = "/tmp/python-test.map"
    with open(path, "wb") as handle:
        handle.write(b"\0" * 8192)
    with open(path, "r+b") as handle:
        mapping = mmap.mmap(handle.fileno(), 8192)
        mapping[0:5] = b"tunix"
        mapping.flush()
        mapping.close()
    with open(path, "rb") as handle:
        head = handle.read(5)
    os.unlink(path)
    assert head == b"tunix", head
    return "8 KiB shared file mapping written through"


def hashing():
    import hashlib

    # A known answer, not just "something came back": without OpenSSL these are
    # CPython's own implementations and a wrong one would still return 64 hex
    # digits.
    expected = "55177e20a83de75cdc3a7f11ecea51d7355b75ffb19637363bdcc5d3b9cefb0b"
    digest = hashlib.sha256(b"tunix").hexdigest()
    assert digest == expected, "sha256(b'tunix') came back as %s" % digest
    return "sha256 known answer, %d algorithms without OpenSSL" % \
        len(hashlib.algorithms_available)


def compression():
    import zlib

    payload = b"tunix " * 5000
    squeezed = zlib.compress(payload, 9)
    assert zlib.decompress(squeezed) == payload, "round trip changed the data"
    return "%d bytes -> %d and back" % (len(payload), len(squeezed))


print("Python %s on %s" % (sys.version.split()[0], os.uname().sysname))
print()

check("imports", imports)
check("files", files)
check("directories", directories)
check("threads", threads)
check("subprocess", subprocesses)
check("signals", signals)
check("unix sockets", sockets)
check("inet sockets", inet_sockets)
check("epoll", polling)
check("sqlite3 memory", database_memory)
check("sqlite3 file", database)
check("ctypes", foreign_calls)
check("mmap", memory_mapping)
check("hashlib", hashing)
check("zlib", compression)

print()
if failures:
    print("python-test: FAIL (%s)" % ", ".join(failures))
    sys.exit(1)
print("python-test: PASS")
