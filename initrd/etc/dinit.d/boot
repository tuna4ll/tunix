# Root of the service graph. dinit (PID 1) starts "boot" and everything else
# hangs off it. waits-for rather than depends-on: a failed unit should leave
# the rest of the system up rather than take boot down with it.
type = internal
waits-for = rcS
waits-for = keymap
# A login prompt on each of the first four virtual terminals, as a distribution
# has: Ctrl+Alt+F1 through Ctrl+Alt+F4.
waits-for = tty1
waits-for = tty2
waits-for = tty3
waits-for = tty4
# The graphical login, which takes a virtual terminal of its own (tty7, from
# /etc/lightdm/lightdm.conf) and leaves the console logins alone. Ctrl+Alt+F7
# comes back to it.
waits-for = lightdm
