# The login prompt on virtual terminal 3, reached with Ctrl+Alt+F3.
#
# restart = true is what makes it a login *service*: when the session ends,
# getty runs again and the next person gets a prompt. dinit's built-in restart
# rate limiting stops a crash loop.
type = process
command = /bin/console-login /dev/tty3
depends-on = rcS
restart = true
