#!/bin/sh
# The X server, as LightDM starts it.
#
# A wrapper rather than a plain xserver-command because two things are not
# expressible in lightdm.conf:
#
#   the terminal  LightDM picks a virtual terminal for the seat (minimum-vt in
#                 lightdm.conf) and passes it to the server as a "vtN"
#                 argument. Xorg is started here with XORG_NO_VT, so it does
#                 not bind that terminal itself -- which would leave the
#                 display owned by whichever terminal happened to be in front
#                 when the first frame was presented. Switching to it first is
#                 what puts the desktop on the terminal LightDM thinks it is
#                 on, so Ctrl+Alt+F7 comes back to it and Ctrl+Alt+F1 leaves it
#                 for a console login.
#   XORG_NO_VT    the Xorg port reads this and skips the VT ioctls entirely;
#                 input comes from evdev and the display from DRM master.
#   -config       there is no autodetection worth the name on one known
#                 machine, so the modesetting DDX is named outright.
export XORG_NO_VT=1
export XKB_BINDIR=/usr/bin

# Must match minimum-vt in lightdm.conf: it is the terminal LightDM will claim
# for the seat, and the one it names below if it names one at all.
terminal=7

args=""
for argument in "$@"; do
    case "$argument" in
        vt[0-9]*) terminal="${argument#vt}" ;;
        *) args="$args $argument" ;;
    esac
done

/bin/chvt "$terminal"

exec /usr/bin/X -config /etc/X11/xorg.conf -nolisten tcp $args
