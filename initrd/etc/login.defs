MAIL_DIR	/var/mail

# The console belongs to whoever is logged in on it, and to nobody else.
TTYGROUP	tty
TTYPERM		0600

ENV_SUPATH	PATH=/usr/sbin:/usr/bin:/sbin:/bin
ENV_PATH	PATH=/usr/bin:/bin:/usr/sbin:/sbin

ERASECHAR	0177
KILLCHAR	025
UMASK		022
HOME_MODE	0755

PASS_MAX_DAYS	99999
PASS_MIN_DAYS	0
PASS_WARN_AGE	7

UID_MIN		1000
UID_MAX		60000
GID_MIN		1000
GID_MAX		60000

LOGIN_RETRIES	5
# No timeout. A getty is running on each of the first four virtual terminals,
# and a timeout makes every one of them give up and be restarted once a minute
# for as long as the machine is up -- which fills the console with service
# churn and throws away anything half-typed at a prompt nobody has answered yet.
# On a machine with a real getty this is the getty's business, not login's.
LOGIN_TIMEOUT	0
FAIL_DELAY	3

# SHA512 is what /etc/shadow already holds, and what musl's crypt() implements.
ENCRYPT_METHOD	SHA512

USERGROUPS_ENAB	yes
CREATE_HOME	yes
