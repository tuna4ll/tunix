export PATH=/usr/bin:/bin:/usr/sbin:/sbin
export SHELL=/bin/bash
export TERM=tunix-256color
export TERMINFO=/usr/share/terminfo
export COLORTERM=truecolor
export INPUTRC=/etc/inputrc
export HISTFILE="${HOME:-/tmp}/.bash_history"
[ -r /etc/bashrc ] && . /etc/bashrc
[ -r /etc/motd ] && cat /etc/motd

# A console login starts the desktop only when nothing else is running one.
#
# With virtual terminals that is no longer the usual case: the display manager
# has a terminal of its own (tty7) and the logins on tty1..tty4 are shells, so
# a login here should stay a shell. It still means something on a machine where
# the display manager has been stopped -- log in on any terminal and the
# desktop comes up on it.
#
# The lock file rather than the socket: the X server on Tunix listens on an
# abstract socket, so /tmp/.X11-unix/X0 is not there to be found and testing
# for it said "no X server" while one was running.
if [ -z "${DISPLAY:-}" ] && [ ! -e /tmp/.X0-lock ] && [ -x /bin/tunix-session ]; then
    exec /bin/tunix-session
fi
