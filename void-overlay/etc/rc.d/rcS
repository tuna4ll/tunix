#!/bin/sh
# Early boot setup for the void_distro experiment. Trimmed from the real
# image's initrd/etc/rc.d/rcS: no dbus, no lightdm, just a writable /tmp and
# the boot marker the same way the real image proves the console came up.
umask 0
mkdir -p /tmp /run
chmod 1777 /tmp
umask 022

# Void's own iproute2, driving this kernel's netlink. There is no dhcpcd in
# this experiment's service graph -- Void's runit scripts never run, since
# dinit replaces runit rather than sitting beside it -- and QEMU's user-mode
# network hands out exactly one address anyway, so it is simpler to know it.
ip addr add 10.0.2.15/24 dev eth0
ip link set eth0 up
ip route add default via 10.0.2.2
echo nameserver 10.0.2.3 > /etc/resolv.conf

echo TUNIX_VOID_BOOT_OK > /dev/console
